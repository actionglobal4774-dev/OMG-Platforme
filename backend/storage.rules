rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isImageUnder10Mb() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isSafeDocumentUnder15Mb() {
      return request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf'
        );
    }

    match /{folder}/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isSafeDocumentUnder15Mb();
    }

    match /moduleDocuments/{moduleId}/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isSafeDocumentUnder15Mb();
    }

    match /kycDocuments/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isSafeDocumentUnder15Mb();
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && isImageUnder10Mb();
    }
  }
}
