{
    "name": "omg-platform-frontend-509",
    "version": "1.0.0",
    "private": true,
    "description": "One Million Global Platform - reconstructed frontend 509",
    "type": "module",
    "scripts": {
        "dev": "vite --configLoader runner",
        "dev:local": "vite --host 127.0.0.1 --port 5180 --configLoader runner",
        "build": "vite build --configLoader runner",
        "serve:dist": "node serve-dist-509.cjs",
        "preview": "vite preview --configLoader runner",
        "mobile:sync": "npm.cmd run build && npx.cmd cap sync",
        "mobile:android": "npm.cmd run build && npx.cmd cap sync android",
        "mobile:ios": "npm.cmd run build && npx.cmd cap sync ios",
        "mobile:open:android": "npx.cmd cap open android",
        "mobile:open:ios": "npx.cmd cap open ios",
        "test:translations": "node scripts/validate-translations.mjs",
        "test:payflow": "node scripts/validate-payflow-entry.mjs",
        "test:store": "node scripts/validate-store-navigation.mjs",
        "test:remaining-modules": "node scripts/validate-remaining-modules.mjs",
        "test:navigation": "node scripts/validate-navigation.mjs",
        "test:navigation-pages": "node scripts/validate-page-navigation.mjs",
        "test:workflows": "node scripts/validate-workflows.mjs",
        "test:university-catalog": "node scripts/validate-university-catalog.mjs",
        "test:university-payment": "node scripts/validate-university-payment.mjs",
        "test:university-all": "node scripts/validate-university-all-journeys.mjs",
        "test:health": "node scripts/validate-health-navigation.mjs",
        "test:travel": "node scripts/validate-travel.mjs",
        "test:mobile": "node scripts/validate-mobile-readiness.mjs",
        "test:frontend": "node scripts/validate-frontend.mjs",
        "test:release": "node scripts/validate-release.mjs",
        "lint": "node scripts/lint-frontend.mjs",
        "test": "node scripts/test-finalization.mjs",
        "test:finalization": "node scripts/test-finalization.mjs",
        "recipe:final": "node scripts/final-recipe.mjs",
        "verify:final": "npm run lint && npm run test:finalization && npm run build && npm run recipe:final",
        "test:translation": "node scripts/validate-translations.mjs",
        "test:traduction": "node scripts/validate-translations.mjs",
        "test:langues": "node scripts/validate-translations.mjs",
        "backend:install": "npm.cmd --prefix backend/functions install",
        "backend:verify": "npm.cmd --prefix backend/functions run verify",
        "backend:serve": "firebase emulators:start --only functions,firestore,storage",
        "verify:platform": "npm run verify:final && npm run backend:verify"
        ,"verify:11-modules": "npm run lint && npm run test:frontend && npm run test:workflows && npm run test:navigation && npm run test:navigation-pages && npm run test:payflow && npm run test:store && npm run test:remaining-modules && npm run test:health && npm run test:travel && npm run test:university-all && npm test && npm run test:mobile && npm run backend:verify && npm run build",
        "verify:12-modules": "npm run verify:11-modules"
    },
    "dependencies": {
        "@capacitor/push-notifications": "^8.0.0",
        "i18next": "^24.2.0",
        "qrcode.react": "^4.2.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-i18next": "^15.4.0",
        "react-icons": "^5.4.0",
        "react-router-dom": "^7.1.1"
    },
    "devDependencies": {
        "@capacitor/android": "^8.4.2",
        "@capacitor/cli": "^8.4.2",
        "@capacitor/core": "^8.4.2",
        "@capacitor/ios": "^8.4.2",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.9.3",
        "vite": "^6.0.5"
    }
}
